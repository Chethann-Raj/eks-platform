{
  "uid": "eks-platform-app",
  "title": "eks-platform / Application",
  "description": "FastAPI request rate, latency, errors and pod resource use for the staging app.",
  "tags": [
    "eks-platform",
    "application"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"app\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"app\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"app\",status=~\"5.*\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"app\"}[5m])), 0.0001)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "",
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request rate by handler",
      "description": "Per-route throughput from prometheus-fastapi-instrumentator, scraped via the app ServiceMonitor.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (handler) (rate(http_requests_total{job=\"app\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "{{handler}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"app\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"app\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"app\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "The instrumentator groups status codes, so values look like 2xx / 4xx / 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_requests_total{job=\"app\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "{{status}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "App pod CPU",
      "description": "1 = one full core.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"staging\",container!=\"\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "App pod memory (working set)",
      "description": "Working set against the configured limit. Crossing the limit line is an OOMKill.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"staging\",container!=\"\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "{{pod}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "min(kube_pod_container_resource_limits{namespace=\"staging\",resource=\"memory\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "limit",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replicas and restarts",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"staging\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "available",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"staging\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "legendFormat": "restarts (5m)",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
